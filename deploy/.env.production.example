# =============================================================================
# .env.production.example — Diferencias de un despliegue REAL tras nginx
#
# Esto NO es un .env completo: es el conjunto de variables cuyo valor cambia
# respecto a backend/.env.example al pasar de "bare-metal directo" a "detrás de
# un nginx que termina TLS". El resto (base de datos, pool, timeouts, logs,
# sesiones…) se toma tal cual de backend/.env.example.
#
# Se mantiene como delta a propósito: duplicar el .env.example entero garantiza
# que los dos archivos se desincronicen en la primera variable que se añada.
#
# Uso:
#   cp backend/.env.example backend/.env
#   # …y sobrescribir en backend/.env las claves de abajo.
# =============================================================================

# -----------------------------------------------------------------------------
# TLS y proxy inverso — las tres que rompen cosas si se dejan en su valor de dev
# -----------------------------------------------------------------------------

NODE_ENV=production

# Hay un nginx delante terminando TLS.
#   - Activa el flag Secure de la cookie de sesión (src/plugins/auth.js).
#   - Añade upgrade-insecure-requests a la CSP (src/plugins/securityHeaders.js).
# Dejarlo en false con TLS delante deja la cookie de sesión sin Secure, viajable
# en claro si algo cae a HTTP.
HTTPS_ENABLED=true

# Saltos de proxy delante del proceso. Con el nginx-icm.conf de este directorio
# es exactamente 1. Súbelo a 2 si además hay un CDN (Cloudflare…) por delante.
#
# Dejarlo en 0 es el error caro: clientIp.js ignora X-Forwarded-For y todas las
# peticiones se contabilizan como 127.0.0.1. Consecuencias inmediatas:
#   - El tope de login por IP (RATE_LIMIT_AUTH_IP_MAX=200 por 15 min) se agota
#     entre TODOS los usuarios, y los 10 intentos por usuario (RATE_LIMIT_AUTH_MAX)
#     se cuentan sobre la misma IP para todos.
#   - El tope por IP de /api (RATE_LIMIT_IP_MAX=5000 por 15 min) se comparte
#     entre todos. La cuota general de cada usuario (RATE_LIMIT_MAX) no, porque
#     cuenta por usuario.
#   - La auditoría registra 127.0.0.1 en cada evento y deja de servir para
#     saber quién descifró qué credencial.
TRUST_PROXY=1

# Dominio real servido por nginx. Mismo origen que la SPA.
CORS_ORIGIN=https://icm.empresa.com

# El backend solo debe ser alcanzable a través de nginx: escuchar en loopback
# en vez de 0.0.0.0 evita que alguien llegue al puerto 8743 saltándose el TLS.
APP_HOST=127.0.0.1
APP_PORT=8743

# -----------------------------------------------------------------------------
# Instalación ya completada
# -----------------------------------------------------------------------------
# Solo en un despliegue nuevo se deja false para pasar por el wizard. Una vez
# instalado, el propio wizard lo pone a true y escribe backend/.installed.
SETUP_COMPLETED=false
SETUP_TOKEN=

# -----------------------------------------------------------------------------
# Secretos — generar POR ENTORNO, nunca reutilizar los de desarrollo
# -----------------------------------------------------------------------------
#   JWT_SECRET:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   MASTER_KEY:  openssl rand -base64 64
#
# Si se pierde MASTER_KEY no hay forma de recuperar las credenciales cifradas.
# Guardarla en un gestor de secretos externo antes del primer arranque.
JWT_SECRET=CHANGE_ME_MINIMUM_64_CHARS_RANDOM_STRING
MASTER_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64

# Contraseña de la base de datos: larga y aleatoria, generada para este entorno.
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# TLS hacia PostgreSQL. Actívalo si la base no está en el mismo host.
DB_SSL=false
# DB_SSL_CA=/etc/ssl/certs/postgres-ca.crt
