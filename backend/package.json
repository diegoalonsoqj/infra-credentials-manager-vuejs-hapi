{
  "name": "infra-credentials-manager-backend",
  "version": "1.0.0",
  "description": "Backend API para administración segura de credenciales de infraestructura",
  "main": "src/app.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "migrate": "node scripts/migrate.js",
    "reset-mfa": "node scripts/reset-mfa.js",
    "backup": "node scripts/backup.js",
    "archive-audit": "node scripts/archive-audit.js",
    "test": "jest --forceExit --runInBand --passWithNoTests",
    "test:coverage": "jest --forceExit --runInBand --coverage --passWithNoTests",
    "lint": "eslint src/ scripts/ tests/ --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@hapi/hapi": "^21.4.10",
    "@hapi/inert": "^7.1.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "joi": "^17.13.7",
    "jsonwebtoken": "^9.0.2",
    "ldapts": "^9.2.0",
    "pg": "^8.12.0",
    "validator": "^13.15.35",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.5.0",
    "globals": "^14.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/src/**/*.test.js"
    ]
  }
}
