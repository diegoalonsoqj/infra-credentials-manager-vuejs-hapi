# =============================================================================
# infra-credentials-manager — Variables de entorno
# Copiar este archivo como .env y ajustar valores antes de iniciar.
# NUNCA commitear el archivo .env al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
NODE_ENV=production
APP_PORT=8743
HTTPS_ENABLED=false   # true solo si el servidor tiene certificado TLS válido (habilita upgrade-insecure-requests en CSP)
APP_HOST=0.0.0.0
APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Base de Datos PostgreSQL 16
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=icm_db
DB_USER=icm_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_SSL=false
# DB_SSL_CA=/path/to/ca.crt   # Ruta a la CA propia. Habilitar en producción con TLS:
#                             # valida el certificado del servidor contra TU CA (RECOMENDADO).
# DB_SSL_REJECT_UNAUTHORIZED=true  # Por defecto 'true' (valida el certificado del servidor).
#                                  # Poner 'false' SOLO en pruebas con cert autofirmado:
#                                  # desactiva la validación y expone a ataques MITM.

# Pool de conexiones
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000

# Timeouts que PostgreSQL aplica a cada conexión del pool.
# statement_timeout cancela consultas colgadas del lado del servidor; sin él, una
# transacción bloqueada retiene un cliente del pool indefinidamente y con
# DB_POOL_MAX conexiones ocupadas la aplicación deja de responder.
# La rotación de Master Key eleva su propio límite, porque re-cifra todas las
# credenciales en una sola sentencia.
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TX_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# JWT — Tokens de autenticación
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# MÍNIMO 64 caracteres aleatorios. Cambiar en cada entorno.
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_MINIMUM_64_CHARS_RANDOM_STRING_DO_NOT_USE_THIS_IN_PRODUCTION
JWT_EXPIRES_IN=8h
# No hay renovación de token: la sesión dura lo que dure JWT_EXPIRES_IN y luego
# hay que volver a iniciar sesión.

# -----------------------------------------------------------------------------
# Master Key para pgcrypto (cifrado de credenciales)
# Generar con: openssl rand -base64 64
# CRÍTICO:
#   - Mínimo 32 caracteres.
#   - NUNCA compartir por canales inseguros.
#   - Guardar en gestor de secretos externo (KeePass, Vault, GCP Secret Manager).
#   - Si se pierde, NO hay forma de recuperar las credenciales cifradas.
# -----------------------------------------------------------------------------
MASTER_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64

# -----------------------------------------------------------------------------
# Wizard de instalación
# ADVERTENCIA: No modificar manualmente. Son gestionados por el wizard.
# -----------------------------------------------------------------------------
SETUP_COMPLETED=false
# SETUP_TOKEN se genera automáticamente si está vacío.
# Se muestra en los logs al iniciar por primera vez para acceder al wizard.
SETUP_TOKEN=

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000    # 15 minutos en milisegundos
RATE_LIMIT_MAX=1000            # Peticiones por ventana y USUARIO autenticado (API general)
RATE_LIMIT_IP_MAX=5000         # Tope por IP contra avalanchas (cabe una oficina tras un NAT)
RATE_LIMIT_AUTH_MAX=10         # Intentos de login por ventana, por USUARIO e IP
RATE_LIMIT_AUTH_IP_MAX=200     # Tope de intentos de login por IP (una oficina tras un NAT)
RATE_LIMIT_MFA_MAX=15          # Gestion del segundo factor por usuario y ventana

# -----------------------------------------------------------------------------
# Proxy inverso — Configura cuántos saltos de proxy hay delante del proceso.
# Necesario para que req.ip refleje la IP real del cliente (auditoría, rate limiting).
#   0 = sin proxy, acceso directo (caso por defecto en bare-metal)
#   1 = detrás de un proxy inverso (nginx, caddy…) que termina TLS
#   2 = doble proxy en cascada
# -----------------------------------------------------------------------------
TRUST_PROXY=0

# -----------------------------------------------------------------------------
# CORS — Orígenes permitidos
# OBLIGATORIO en producción: cambiar al dominio real (https://icm.empresa.com).
# Dejar vacío en local solo si el frontend corre en el mismo puerto que el backend.
# -----------------------------------------------------------------------------
CORS_ORIGIN=https://CHANGE_ME_YOUR_DOMAIN.com

# -----------------------------------------------------------------------------
# Logs (Winston + DailyRotateFile)
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_FILES=30d
LOG_MAX_SIZE=20m

# -----------------------------------------------------------------------------
# Sesiones
# -----------------------------------------------------------------------------
SESSION_MAX_CONCURRENT=3       # Sesiones simultáneas máximas por usuario
# Aquí figuraba SESSION_PRD_TIMEOUT_MIN, un timeout más corto para las sesiones
# que hubieran accedido a credenciales de producción. Nunca se implementó: la
# variable no se leía en ninguna parte y anunciaba un control inexistente. Todas
# las sesiones caducan igual (JWT_EXPIRES_IN). Se retira hasta que exista.

# -----------------------------------------------------------------------------
# Auditoría
# -----------------------------------------------------------------------------
# La auditoría no tiene interruptor: el descifrado de credenciales registra
# SIEMPRE de forma bloqueante (si no se puede registrar, no se entrega la
# contraseña) y el resto de acciones registran sin bloquear la respuesta.

# -----------------------------------------------------------------------------
# Modo de despliegue
# Este proyecto corre en bare-metal: dejar SIEMPRE en false.
# (La variable se conserva por compatibilidad con rutas internas del setup.)
# -----------------------------------------------------------------------------
DOCKER_ENV=false

# -----------------------------------------------------------------------------
# Copias de seguridad (npm run backup — ver deploy/RECUPERACION.md)
#
# La copia NO incluye la MASTER_KEY, y sin ella no se descifra nada. La clave se
# custodia APARTE de las copias: juntas, el cifrado no protege de nada; la clave
# perdida, las credenciales son irrecuperables.
#
# BACKUP_DIR debe apuntar fuera del repositorio y, a ser posible, a un disco o
# recurso distinto del de la base de datos. Por defecto ya cae fuera del arbol de
# codigo (../icm-backups, junto al repositorio); si apuntas a un sitio dentro del
# repositorio el script lo avisa en cada ejecucion. Al crear el directorio se le
# quitan los permisos heredados (icacls en Windows, chmod 0700 en el resto).
# -----------------------------------------------------------------------------
# BACKUP_DIR=/var/backups/icm
# Los tres valores tienen que ser numeros enteros (0 o mas): un valor mal escrito
# aborta la ejecucion en vez de aplicar una retencion sin sentido.
# BACKUP_KEEP_DAILY=7            # copias diarias que se conservan
# BACKUP_KEEP_WEEKLY=4           # una por semana, además de las diarias
# BACKUP_KEEP_MONTHLY=12         # una por mes, además de las anteriores
# PG_BIN=/usr/lib/postgresql/16/bin   # si pg_dump no está en el PATH, o hay varias versiones

# --verify restaura la copia en una base temporal para comprobarla, y eso exige
# un rol que pueda CREAR BASES. El rol de la aplicación no lo tiene ni conviene
# dárselo: pásalas al vuelo solo en esa ejecución, mejor que escribirlas aquí.
#   BACKUP_ADMIN_USER=postgres BACKUP_ADMIN_PASSWORD=... npm run backup -- --verify

# -----------------------------------------------------------------------------
# KMS externo (Futuro — descomentar cuando se implemente)
# Permite migrar el cifrado de LOCAL (variable de entorno) a un KMS gestionado.
# -----------------------------------------------------------------------------
# KMS_PROVIDER=LOCAL           # LOCAL | GCP | AWS | AZURE
# GCP_KMS_KEY_RESOURCE=projects/myproject/locations/global/keyRings/icm/cryptoKeys/master
# AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/abcd-1234-...
# AZURE_KMS_KEY_VAULT=https://myvault.vault.azure.net/keys/icm-master/...
